#!/bin/bash

# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

MODUS_THEME="operandi"
[ -r "$HOME/.cache/modus-theme/current" ] && MODUS_THEME="$(cat "$HOME/.cache/modus-theme/current")"
if [ "$MODUS_THEME" = "vivendi" ]; then
  BAR_COLOR=0xff000000
  BORDER_COLOR=0xff646464
  TEXT_COLOR=0xffffffff
  SPACE_BG=0xff1e1e1e
  SPACE_FG=0xff989898
else
  BAR_COLOR=0xffffffff
  BORDER_COLOR=0xffc4c4c4
  TEXT_COLOR=0xff000000
  SPACE_BG=0xfff2f2f2
  SPACE_FG=0xff595959
fi

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# Full-width strip tall enough to align with the MacBook camera housing.
sketchybar --bar position=top height=36 notch_display_height=36 margin=0 y_offset=0 \
                 corner_radius=0 padding_left=16 padding_right=16 \
                 blur_radius=0 shadow=off topmost=window \
                 color="$BAR_COLOR" border_width=0

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=4
  padding_right=4
  icon.font="IoskeleyMono Nerd Font Mono:Medium:13.0"
  label.font="IoskeleyMono Nerd Font Mono:Medium:13.0"
  icon.color="$TEXT_COLOR"
  label.color="$TEXT_COLOR"
  icon.padding_left=2
  icon.padding_right=3
  label.padding_left=0
  label.padding_right=2
)
sketchybar --default "${default[@]}"

# Custom event triggered by AeroSpace's native on-focus-changed callback.
sketchybar --add event aerospace_focus_changed

##### Adding AeroSpace Workspace Indicators #####

SPACE_NAMES=("WEB" "TERM" "CODE" "FILES" "KNOW" "LIFE" "MEDIA" "PLAN" "AI" "COMMS")
for i in "${!SPACE_NAMES[@]}"
do
  sid="$((i + 1))"
  display_number="$sid"
  [ "$sid" -eq 10 ] && display_number=0
  workspace=(
    padding_left=2
    padding_right=2
    icon.drawing=off
    label.font="IoskeleyMono Nerd Font Mono:Bold:11.0"
    background.drawing=on
    background.color="$SPACE_BG"
    background.corner_radius=5
    background.height=26
    label="$display_number ${SPACE_NAMES[i]}"
    label.drawing=on
    label.color="$SPACE_FG"
    label.padding_left=8
    label.padding_right=8
    script="$PLUGIN_DIR/space.sh"
    click_script="aerospace workspace $sid"
  )
  sketchybar --add item space."$sid" left \
             --set space."$sid" "${workspace[@]}" \
             --subscribe space."$sid" aerospace_focus_changed
done

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock update_freq=10 icon=  script="$PLUGIN_DIR/clock.sh" \
           --add item next_event right \
           --set next_event update_freq=60 script="$PLUGIN_DIR/next_event.sh" \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item network right \
           --set network update_freq=30 script="$PLUGIN_DIR/network.sh" \
           --add item tailscale right \
           --set tailscale update_freq=30 script="$PLUGIN_DIR/tailscale.sh"

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update

# Run the compact title bar as an independent SketchyBar instance. Its
# executable name gives it a separate command socket and configuration.
BOTTOM_BAR="$HOME/.local/bin/sketchybar-bottom"
if [ -x "$BOTTOM_BAR" ]; then
  # SketchyBar's instance lock makes this safe on every top-bar reload.
  "$BOTTOM_BAR" >/dev/null 2>&1 &
fi
